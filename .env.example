# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# SOLO servidor (nunca con prefijo NEXT_PUBLIC_). Se usa únicamente para crear usuarios
# desde Administración → Usuarios. Si no la configurás, esa función queda deshabilitada.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta
